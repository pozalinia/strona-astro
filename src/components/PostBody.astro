---
import { render } from 'astro:content';
import { enhanceContent } from '../lib/content';
import type { Page, Post } from '../lib/site';

interface Props {
  entry: Post | Page;
}

const { entry } = Astro.props;
const isHtml = entry.data.format === 'html';
const Content = isHtml ? undefined : (await render(entry)).Content;
---

{isHtml ? <Fragment set:html={enhanceContent(entry.body ?? '')} /> : Content && <Content />}

<style is:global>
  /* Wpisy w Markdownie (Sveltia) nie przechodzą przez enhanceContent, więc iframe nie dostaje
     wrappera .post__iframe z proporcjami – bez tego osadzenie ma stałe 560 px szerokości. */
  .content__entry iframe:not(.post__iframe iframe) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
  }
</style>
