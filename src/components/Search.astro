---
// Lupa w nagłówku i okno wyszukiwania z wynikami w trakcie pisania
---

<div class="search">
  <button class="search__btn" type="button" aria-label="Szukaj" aria-haspopup="dialog" data-search-open>
    <svg width="18" height="18" aria-hidden="true" focusable="false">
      <use xlink:href="/assets/svg/svg-map.svg#search"></use>
    </svg>
  </button>
  <dialog class="search-dialog" aria-label="Szukaj" data-search-dialog>
    <form action="/szukaj/" class="search-field" role="search">
      <svg width="20" height="20" aria-hidden="true" focusable="false">
        <use xlink:href="/assets/svg/svg-map.svg#search"></use>
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Szukaj w czasopiśmie…"
        aria-label="Szukaj"
        autocomplete="off"
        data-search-input
      />
      <button type="button" class="search-dialog__close" aria-label="Zamknij wyszukiwarkę" data-search-close>Esc</button>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-search-status></p>
    <div class="search-results" data-search-results></div>
    <a class="search-dialog__all" href="/szukaj/" hidden data-search-all></a>
  </dialog>
</div>

<style is:global>
  .search__btn {
    justify-content: center;
  }
  /* Po zamknięciu okna fokus wraca na lupę – bez tego zostawałaby wypełniona jak po najechaniu */
  .search__btn:focus:not(:focus-visible):not(:hover) {
    background: none;
    color: var(--dark);
  }

  html:has(.search-dialog[open]) {
    overflow: hidden;
  }
  .search-dialog {
    background: var(--page-bg);
    border: 1px solid var(--light);
    border-radius: 14px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    color: var(--text-color);
    margin: 12vh auto auto;
    max-height: 76vh;
    max-width: calc(100vw - 2rem);
    overflow: hidden;
    padding: 0;
    width: 42rem;
  }
  .search-dialog[open] {
    animation: search-dialog-in 0.16s ease-out;
    display: flex;
    flex-direction: column;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
  }
  @keyframes search-dialog-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (max-width: 37.5em) {
    .search-dialog {
      margin-top: 1rem;
      max-height: calc(100dvh - 2rem);
    }
  }

  /* Pole z lupą: w oknie i na stronie /szukaj/ */
  .search-field {
    align-items: center;
    color: var(--gray);
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 1rem 1.2rem;
  }
  .search-field svg {
    flex-shrink: 0;
  }
  .search-field input[type='search'] {
    background: none;
    border: none;
    color: var(--headings-color);
    flex: 1;
    font-family: var(--heading-font);
    font-size: 1.1rem;
    min-width: 0;
    padding: 0;
    width: auto;
  }
  .search-field input[type='search']:focus-visible {
    outline: 0 !important;
  }
  .search-field input[type='search']::placeholder {
    color: var(--gray);
  }
  .search-field input[type='search']::-webkit-search-cancel-button {
    display: none;
  }
  .search-dialog .search-field {
    border-bottom: 1px solid var(--light);
  }
  .search-dialog__close {
    border-color: var(--light);
    border-radius: 6px;
    color: var(--gray);
    flex-shrink: 0;
    font-size: 0.7rem;
    margin: 0;
    padding: 0.2rem 0.5rem;
    width: auto;
  }

  .search-status {
    color: var(--gray);
    font-size: 0.8239746086rem;
    margin: 0;
  }
  .search-status:empty {
    display: none;
  }
  .search-dialog .search-status {
    padding: 0.8rem 1.2rem 0.3rem;
  }
  .search-dialog .search-results {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.3rem 0.5rem 0.5rem;
  }

  .search-result {
    border-radius: 8px;
    color: inherit;
    display: block;
    padding: 0.7rem;
    text-decoration: none;
    transition: background 0.12s ease-out;
  }
  .search-result:hover,
  .search-result:focus-visible {
    background: rgba(128, 128, 128, 0.16);
    color: inherit;
  }
  .search-result > span {
    display: block;
  }
  .search-result__title {
    color: var(--headings-color);
    font-family: var(--heading-font);
    font-size: 1.05rem;
    font-variation-settings: 'wght' var(--font-weight-bold);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
  }
  .search-result__meta {
    color: var(--gray);
    font-family: var(--menu-font);
    font-size: 0.78rem;
    line-height: 1.4;
    margin-top: 0.2rem;
  }
  .search-result__snippet {
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: 0.35rem;
  }
  .search-result mark {
    background: none;
    color: var(--link-color-hover);
    font-variation-settings: 'wght' var(--font-weight-bold);
    font-weight: var(--font-weight-bold);
    padding: 0;
  }

  .search-dialog__all {
    border-top: 1px solid var(--light);
    font-family: var(--menu-font);
    font-size: 0.8239746086rem;
    padding: 0.8rem 1.2rem;
    text-align: center;
    text-decoration: none;
  }
  .search-dialog__all[hidden] {
    display: none;
  }
</style>

<script>
  import { setupSearch } from '../scripts/search';

  const open = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const results = dialog?.querySelector<HTMLElement>('[data-search-results]');
  const all = dialog?.querySelector<HTMLAnchorElement>('[data-search-all]');

  if (open && dialog && input && status && results && all) {
    const limit = 8;
    const hint = 'Wpisz tytuł, nazwisko lub fragment tekstu.';
    const search = setupSearch({
      input,
      status,
      results,
      limit,
      hint,
      snippet: [40, 110],
      onResults(query, total) {
        all.hidden = total <= limit;
        all.href = `/szukaj/?q=${encodeURIComponent(query)}`;
        all.textContent = `Pokaż wszystkie wyniki (${total})`;
      },
    });

    open.addEventListener('click', () => {
      // Na stronie /szukaj/ pole jest już na ekranie
      const pageInput = document.querySelector<HTMLInputElement>('[data-search-page-input]');
      if (pageInput) {
        pageInput.focus();
        pageInput.select();
        return;
      }
      dialog.showModal();
      input.select();
      search(input.value);
    });
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    // Kliknięcie w tło (poza oknem) zamyka
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
