---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base bodyClass="error-template" title={`Error 404 - ${SITE.name}`} robots="noindex, follow" canonical={false}>
  <main class="page page--error">
    <div class="content">
      <div class="hero">
        <header class="hero__content hero__content--centered">
          <div class="wrapper">
            <h1>Błąd 404</h1>
            <div class="page__desc">
              <p>Nie znaleźliśmy strony, której szukasz.</p>
            </div>
            <a href="/" class="btn hero__cta btn--icon">
              <svg width="18" height="18" aria-hidden="true">
                <use xlink:href="/assets/svg/svg-map.svg#arrow-prev"></use>
              </svg>
              <span>Wróć na stronę główną</span>
            </a>
          </div>
        </header>
      </div>
    </div>
  </main>
</Base>
