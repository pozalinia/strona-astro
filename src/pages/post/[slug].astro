---
import PostCustom from '../../components/post/PostCustom.astro';
import PostDefault from '../../components/post/PostDefault.astro';
import Base from '../../layouts/Base.astro';
import { metaDescription } from '../../lib/content';
import { getLookups, getPosts, type Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lookups = await getLookups();
const isCustom = post.data.template !== 'default';
---

<Base
  bodyClass="post-template"
  title={post.data.metaTitle}
  description={post.data.metaDescription || metaDescription(post.body ?? '')}
  bioToggle={isCustom}
>
  {isCustom ? <PostCustom post={post} lookups={lookups} /> : <PostDefault post={post} />}
</Base>
